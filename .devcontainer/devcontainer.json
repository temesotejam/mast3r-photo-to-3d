{
  "name": "MASt3R Photo to 3D",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "forwardPorts": [7861],
  "portsAttributes": {
    "7861": {
      "label": "MASt3R Photo to 3D",
      "protocol": "http",
      "onAutoForward": "openBrowserOnce"
    }
  },
  "postCreateCommand": ["bash", "scripts/start-codespace.sh", "install"],
  "postStartCommand": ["bash", "scripts/start-codespace.sh"],
  "waitFor": "postCreateCommand"
}
